'use client';

import React, { useState, useEffect, useMemo } from 'react';
import { Card, Select, Button, Space, Typography, Tag, Tooltip, Modal, Descriptions, Spin, Empty, Badge, message, Progress } from 'antd';
import { 
  AppstoreOutlined, EnvironmentOutlined, InboxOutlined, 
  ZoomInOutlined, ZoomOutOutlined, InfoCircleOutlined, ShopOutlined,
  BoxPlotOutlined
} from '@ant-design/icons';

const { Title, Text } = Typography;
const { Option } = Select;

// 颜色映射 - 根据盒子占用数
const getColorByBoxes = (usedBoxes: number): string => {
  if (usedBoxes === 0) return '#f0f0f0'; // 空 - 灰色
  if (usedBoxes <= 3) return '#d4edda'; // 1-3盒 - 浅绿
  if (usedBoxes <= 6) return '#fff3cd'; // 4-6盒 - 浅黄
  if (usedBoxes <= 8) return '#ffe0b2'; // 7-8盒 - 浅橙
  return '#f8d7da'; // 9-10盒 - 浅红
};

const getStatusByBoxes = (usedBoxes: number) => {
  if (usedBoxes === 0) return <Tag color="default">空置</Tag>;
  if (usedBoxes <= 3) return <Tag color="green">低占用</Tag>;
  if (usedBoxes <= 6) return <Tag color="gold">中占用</Tag>;
  if (usedBoxes <= 8) return <Tag color="orange">高占用</Tag>;
  return <Tag color="red">已满</Tag>;
};

interface BoxData {
  boxCode: string; // 如 A-1-1-1
  locationCode: string; // 如 A-1-1
  productName?: string;
  productCode?: string;
  quantity?: number;
  occupied: boolean;
}

interface LocationData {
  code: string; // 如 A-1-1
  name: string;
  zoneCode: string;
  boxes: BoxData[]; // 10个盒子
  usedBoxes: number;
}

interface ZoneData {
  id: string;
  name: string;
  code: string;
  locationCount: number;
}

export default function ShelfMapPage() {
  const [warehouses, setWarehouses] = useState<any[]>([]);
  const [selectedWarehouse, setSelectedWarehouse] = useState<number | null>(null);
  const [selectedZone, setSelectedZone] = useState<string>('');
  const [zones, setZones] = useState<ZoneData[]>([]);
  const [locations, setLocations] = useState<LocationData[]>([]);
  const [loading, setLoading] = useState(false);
  const [detailOpen, setDetailOpen] = useState(false);
  const [selectedLocation, setSelectedLocation] = useState<LocationData | null>(null);
  const [viewMode, setViewMode] = useState<'shelf' | 'overview'>('shelf');
  const [isMobile, setIsMobile] = useState(false);
  const [zoom, setZoom] = useState(1);

  useEffect(() => {
    const checkMobile = () => setIsMobile(window.innerWidth < 768);
    checkMobile();
    window.addEventListener('resize', checkMobile);
    return () => window.removeEventListener('resize', checkMobile);
  }, []);

  // 加载仓库列表
  useEffect(() => {
    const loadWarehouses = async () => {
      try {
        const res = await fetch('/api/warehouse');
        const data = await res.json();
        if (data.success) {
          setWarehouses(data.data || []);
          if (data.data?.length > 0 && !selectedWarehouse) {
            setSelectedWarehouse(data.data[0].id);
          }
        }
      } catch (e) {
        console.error(e);
      }
    };
    loadWarehouses();
  }, []);

  // 加载库位数据
  useEffect(() => {
    if (!selectedWarehouse) return;
    loadLocationData();
  }, [selectedWarehouse]);

  const loadLocationData = async () => {
    setLoading(true);
    try {
      const res = await fetch(`/api/shelf-map?warehouseId=${selectedWarehouse}`);
      const data = await res.json();
      if (data.success) {
        const locs = data.data || [];
        
        // 按货位分组，生成盒子数据
        const locationMap: Record<string, LocationData> = {};
        
        locs.forEach((loc: any) => {
          const code = loc.code; // 如 A-1-1
          if (!locationMap[code]) {
            locationMap[code] = {
              code,
              name: loc.name || code,
              zoneCode: loc.zoneCode || code.split('-')[0],
              boxes: [],
              usedBoxes: 0,
            };
          }
          
          // 如果有库存，记录到盒子中
          if (loc.quantity > 0) {
            locationMap[code].usedBoxes++;
            // 为每个有库存的记录创建一个盒子
            locationMap[code].boxes.push({
              boxCode: `${code}-${locationMap[code].boxes.length + 1}`,
              locationCode: code,
              productName: loc.productName,
              productCode: loc.productCode,
              quantity: loc.quantity,
              occupied: true,
            });
          }
        });
        
        // 补全空盒子（每个货位10个盒子）
        Object.values(locationMap).forEach(loc => {
          while (loc.boxes.length < 10) {
            loc.boxes.push({
              boxCode: `${loc.code}-${loc.boxes.length + 1}`,
              locationCode: loc.code,
              occupied: false,
            });
          }
        });
        
        setLocations(Object.values(locationMap));
        
        // 获取仓库的区域列表
        const whRes = await fetch('/api/warehouse');
        const whData = await whRes.json();
        if (whData.success) {
          const currentWh = (whData.data || []).find((w: any) => w.id == selectedWarehouse);
          if (currentWh?.zones) {
            setZones(currentWh.zones);
            if (!selectedZone && currentWh.zones.length > 0) {
              setSelectedZone(currentWh.zones[0].code);
            }
          }
        }
      }
    } catch (e) {
      console.error(e);
      message.error('加载库位数据失败');
    } finally {
      setLoading(false);
    }
  };

  // 当前选中的区域的货位矩阵
  const zoneMatrix = useMemo(() => {
    const COLS = 10;
    const ROWS = 10;
    
    // 找出该区域的所有货位
    const zoneLocations = locations.filter(loc => loc.zoneCode === selectedZone);
    
    // 构建矩阵
    const matrix: (LocationData | null)[][] = [];
    for (let row = ROWS; row >= 1; row--) {
      const rowData: (LocationData | null)[] = [];
      for (let col = 1; col <= COLS; col++) {
        const code = `${selectedZone}-${col}-${row}`;
        rowData.push(zoneLocations.find(l => l.code === code) || null);
      }
      matrix.push(rowData);
    }
    return matrix;
  }, [selectedZone, locations]);

  // 区域统计
  const zoneStats = useMemo(() => {
    const stats: Record<string, { total: number; occupied: number }> = {};
    zones.forEach(z => {
      stats[z.code] = { total: 0, occupied: 0 };
    });
    
    locations.forEach(loc => {
      if (stats[loc.zoneCode]) {
        stats[loc.zoneCode].total++;
        if (loc.usedBoxes > 0) {
          stats[loc.zoneCode].occupied++;
        }
      }
    });
    
    return stats;
  }, [zones, locations]);

  const handleLocationClick = (loc: LocationData) => {
    setSelectedLocation(loc);
    setDetailOpen(true);
  };

  // 概览数据
  const overviewZones = useMemo(() => {
    return zones.map(z => {
      const stats = zoneStats[z.code] || { total: 0, occupied: 0 };
      return {
        ...z,
        ...stats,
        rate: stats.total > 0 ? stats.occupied / stats.total : 0,
      };
    });
  }, [zones, zoneStats]);

  const currentZoneStats = zoneStats[selectedZone] || { total: 0, occupied: 0 };

  return (
    <div style={{ padding: isMobile ? 12 : 24 }}>
      <div style={{ 
        display: 'flex', 
        flexDirection: isMobile ? 'column' : 'row',
        justifyContent: 'space-between', 
        alignItems: isMobile ? 'stretch' : 'center',
        marginBottom: isMobile ? 12 : 24,
        gap: isMobile ? 12 : 0
      }}>
        <Title level={4} style={{ margin: 0 }}>
          <ShopOutlined style={{ marginRight: 8 }} />
          货架地图
        </Title>
        <Space direction={isMobile ? 'vertical' : 'horizontal'} style={{ width: isMobile ? '100%' : 'auto' }}>
          <Select
            placeholder="选择仓库"
            style={{ width: isMobile ? '100%' : 200 }}
            value={selectedWarehouse}
            onChange={setSelectedWarehouse}
          >
            {warehouses.map((w: any) => (
              <Option key={w.id} value={w.id}>{w.name}</Option>
            ))}
          </Select>
          <Button.Group>
            <Button 
              type={viewMode === 'shelf' ? 'primary' : 'default'}
              onClick={() => setViewMode('shelf')}
            >
              货架视图
            </Button>
            <Button 
              type={viewMode === 'overview' ? 'primary' : 'default'}
              onClick={() => setViewMode('overview')}
            >
              总览
            </Button>
          </Button.Group>
        </Space>
      </div>

      <Spin spinning={loading}>
        {zones.length === 0 ? (
          <Card>
            <Empty 
              description={
                <span>
                  该仓库暂无货架数据<br />
                  <Text type="secondary">请先在仓库管理中创建仓库，系统会自动创建 A-M 货架和货位</Text>
                </span>
              }
            >
              <Button type="primary" onClick={() => window.location.href = '/warehouse'}>
                前往仓库管理
              </Button>
            </Empty>
          </Card>
        ) : viewMode === 'overview' ? (
          /* ========== 总览视图 ========== */
          <Card title="仓库货架总览">
            <div style={{ 
              display: 'grid', 
              gridTemplateColumns: isMobile ? 'repeat(2, 1fr)' : 'repeat(auto-fill, minmax(160px, 1fr))',
              gap: 16 
            }}>
              {overviewZones.map(zone => (
                <Card
                  key={zone.code}
                  hoverable
                  size="small"
                  onClick={() => {
                    setSelectedZone(zone.code);
                    setViewMode('shelf');
                  }}
                  style={{ 
                    background: getColorByBoxes(zone.occupied),
                    cursor: 'pointer',
                    border: selectedZone === zone.code ? '2px solid #1677ff' : '1px solid #f0f0f0',
                  }}
                >
                  <div style={{ textAlign: 'center' }}>
                    <div style={{ fontSize: 28, fontWeight: 700, color: '#1f2937' }}>
                      {zone.code}
                    </div>
                    <div style={{ fontSize: 12, color: '#666', marginTop: 4 }}>
                      {zone.name}
                    </div>
                    <div style={{ marginTop: 8 }}>
                      {getStatusByBoxes(zone.occupied)}
                    </div>
                    <div style={{ fontSize: 11, color: '#999', marginTop: 4 }}>
                      {zone.occupied}/{zone.total} 位有货
                    </div>
                  </div>
                </Card>
              ))}
            </div>
            
            <div style={{ 
              marginTop: 24, 
              padding: 16, 
              background: '#fafafa', 
              borderRadius: 8,
              display: 'flex',
              flexWrap: 'wrap',
              gap: 16,
              justifyContent: 'center'
            }}>
              <Space><div style={{ width: 16, height: 16, background: '#f0f0f0', borderRadius: 2 }} /> <Text type="secondary">空置</Text></Space>
              <Space><div style={{ width: 16, height: 16, background: '#d4edda', borderRadius: 2 }} /> <Text type="secondary">1-3盒</Text></Space>
              <Space><div style={{ width: 16, height: 16, background: '#fff3cd', borderRadius: 2 }} /> <Text type="secondary">4-6盒</Text></Space>
              <Space><div style={{ width: 16, height: 16, background: '#ffe0b2', borderRadius: 2 }} /> <Text type="secondary">7-8盒</Text></Space>
              <Space><div style={{ width: 16, height: 16, background: '#f8d7da', borderRadius: 2 }} /> <Text type="secondary">9-10盒</Text></Space>
            </div>
          </Card>
        ) : (
          /* ========== 货架视图 ========== */
          <>
            {/* 区域选择标签 */}
            <Card size="small" style={{ marginBottom: 16 }}>
              <div style={{ 
                display: 'flex', 
                overflowX: 'auto', 
                gap: 8,
                padding: '4px 0',
              }}>
                {zones.map(zone => {
                  const stats = zoneStats[zone.code] || { total: 0, occupied: 0 };
                  return (
                    <Button
                      key={zone.code}
                      type={selectedZone === zone.code ? 'primary' : 'default'}
                      onClick={() => setSelectedZone(zone.code)}
                      style={{ 
                        minWidth: isMobile ? 48 : 64,
                        flexShrink: 0,
                        background: selectedZone === zone.code ? undefined : getColorByBoxes(stats.occupied),
                      }}
                    >
                      {zone.code}
                      {stats.occupied > 8 && <Badge dot color="red" offset={[-4, 4]} />}
                    </Button>
                  );
                })}
              </div>
            </Card>

            {/* 货架信息 */}
            <Card size="small" style={{ marginBottom: 16 }}>
              <div style={{ 
                display: 'flex', 
                flexDirection: isMobile ? 'column' : 'row',
                justifyContent: 'space-between',
                alignItems: isMobile ? 'stretch' : 'center',
                gap: isMobile ? 8 : 0
              }}>
                <Space wrap>
                  <Text strong style={{ fontSize: 16 }}>{selectedZone}货架</Text>
                  {getStatusByBoxes(currentZoneStats.occupied)}
                  <Text type="secondary">
                    有货: {currentZoneStats.occupied} / {currentZoneStats.total} 位
                  </Text>
                </Space>
                <Space>
                  <Tooltip title="放大">
                    <Button icon={<ZoomInOutlined />} size="small" onClick={() => setZoom(Math.min(zoom + 0.2, 2))} disabled={zoom >= 2} />
                  </Tooltip>
                  <Tooltip title="缩小">
                    <Button icon={<ZoomOutOutlined />} size="small" onClick={() => setZoom(Math.max(zoom - 0.2, 0.6))} disabled={zoom <= 0.6} />
                  </Tooltip>
                  <Tooltip title="重置">
                    <Button size="small" onClick={() => setZoom(1)}>1:1</Button>
                  </Tooltip>
                </Space>
              </div>
            </Card>

            {/* 货架网格 */}
            <Card 
              title={
                <Space>
                  <EnvironmentOutlined />
                  <span>{selectedZone}货架 - 10列 × 10层</span>
                  <Tooltip title="点击格子查看该货位的10个小盒子">
                    <InfoCircleOutlined style={{ color: '#999' }} />
                  </Tooltip>
                </Space>
              }
              style={{ overflow: 'auto' }}
            >
              {currentZoneStats.total === 0 ? (
                <Empty description="该货架暂无货位数据" />
              ) : (
                <>
                  <div style={{ overflow: 'auto', maxHeight: isMobile ? '60vh' : '70vh' }}>
                    <div style={{ 
                      transform: `scale(${zoom})`,
                      transformOrigin: 'top left',
                      transition: 'transform 0.2s',
                    }}>
                      {/* 列号 header */}
                      <div style={{ 
                        display: 'grid',
                        gridTemplateColumns: `40px repeat(10, 1fr)`,
                        gap: 2,
                        marginBottom: 4,
                        minWidth: isMobile ? 360 : 600,
                      }}>
                        <div style={{ padding: '4px 0', textAlign: 'center', fontSize: 11, color: '#999', fontWeight: 500 }}>
                          层╲列
                        </div>
                        {Array.from({ length: 10 }, (_, i) => (
                          <div key={i} style={{ 
                            padding: '4px 0', textAlign: 'center', fontSize: 12, fontWeight: 600,
                            color: '#374151', background: '#f9fafb', borderRadius: 4,
                          }}>
                            {i + 1}列
                          </div>
                        ))}
                      </div>

                      {/* 行数据 */}
                      {zoneMatrix.map((row, rowIndex) => (
                        <div key={rowIndex} style={{ 
                          display: 'grid',
                          gridTemplateColumns: `40px repeat(10, 1fr)`,
                          gap: 2,
                          marginBottom: 2,
                          minWidth: isMobile ? 360 : 600,
                        }}>
                          <div style={{ 
                            display: 'flex', alignItems: 'center', justifyContent: 'center',
                            fontSize: 12, fontWeight: 600, color: '#374151', background: '#f9fafb', borderRadius: 4,
                          }}>
                            {10 - rowIndex}层
                          </div>
                          {row.map((loc, colIndex) => {
                            const cellClick = () => {
                              if (loc) {
                                handleLocationClick(loc);
                              }
                            };
                            return (
                              <div
                                key={colIndex}
                                onClick={cellClick}
                                style={{
                                  background: loc ? getColorByBoxes(loc.usedBoxes) : '#fafafa',
                                  borderRadius: 4,
                                  padding: '6px 4px',
                                  textAlign: 'center',
                                  cursor: loc ? 'pointer' : 'default',
                                  border: '1px solid transparent',
                                  transition: 'all 0.2s',
                                  minHeight: isMobile ? 36 : 44,
                                  display: 'flex',
                                  flexDirection: 'column',
                                  alignItems: 'center',
                                  justifyContent: 'center',
                                }}
                                onMouseEnter={(e) => {
                                  if (loc) {
                                    e.currentTarget.style.border = '1px solid #1677ff';
                                    e.currentTarget.style.boxShadow = '0 2px 8px rgba(22,119,255,0.2)';
                                  }
                                }}
                                onMouseLeave={(e) => {
                                  e.currentTarget.style.border = '1px solid transparent';
                                  e.currentTarget.style.boxShadow = 'none';
                                }}
                              >
                                <Tooltip
                                  title={
                                    loc ? (
                                      <div style={{ maxWidth: 300 }}>
                                        <div style={{ fontWeight: 600, marginBottom: 8, borderBottom: '1px solid #fff', paddingBottom: 4 }}>
                                          📦 {loc.code} - {loc.usedBoxes}/10盒
                                        </div>
                                        {loc.boxes.map((box, idx) => (
                                          <div 
                                            key={box.boxCode} 
                                            style={{ 
                                              padding: '2px 0', 
                                              fontSize: 11,
                                              background: box.occupied ? 'rgba(22,119,255,0.1)' : 'transparent',
                                              borderRadius: 2,
                                              paddingLeft: 4,
                                              marginBottom: 2,
                                            }}
                                          >
                                            <span style={{ color: '#d9d9d9' }}>[{idx + 1}]</span>{' '}
                                            {box.occupied ? (
                                              <span>
                                                <span style={{ color: '#fff' }}>{box.productName}</span>
                                                {' '}
                                                <Tag color="green" style={{ margin: 0, fontSize: 10 }}>×{box.quantity}</Tag>
                                              </span>
                                            ) : (
                                              <span style={{ color: '#666' }}>空</span>
                                            )}
                                          </div>
                                        ))}
                                      </div>
                                    ) : '空位'
                                  }
                                >
                                  <span style={{ pointerEvents: 'none' }}>
                                    {loc ? (
                                      loc.usedBoxes > 0 ? (
                                        <>
                                          <BoxPlotOutlined style={{ fontSize: isMobile ? 12 : 14, color: '#1677ff' }} />
                                          <div style={{ fontSize: 10, color: '#666', marginTop: 2 }}>
                                            {loc.usedBoxes}/10
                                          </div>
                                        </>
                                      ) : (
                                        <div style={{ fontSize: 10, color: '#ccc' }}>空</div>
                                      )
                                    ) : (
                                      <div style={{ fontSize: 10, color: '#eee' }}>-</div>
                                    )}
                                  </span>
                                </Tooltip>
                              </div>
                            );
                          })}
                        </div>
                      ))}
                    </div>
                  </div>

                  {/* 图例 */}
                  <div style={{ 
                    marginTop: 16, padding: 12, background: '#fafafa', borderRadius: 8,
                    display: 'flex', flexWrap: 'wrap', gap: 12, justifyContent: 'center'
                  }}>
                    <Space size={4}><div style={{ width: 12, height: 12, background: '#f0f0f0', borderRadius: 2 }} /> <Text type="secondary" style={{ fontSize: 11 }}>空</Text></Space>
                    <Space size={4}><div style={{ width: 12, height: 12, background: '#d4edda', borderRadius: 2 }} /> <Text type="secondary" style={{ fontSize: 11 }}>1-3盒</Text></Space>
                    <Space size={4}><div style={{ width: 12, height: 12, background: '#fff3cd', borderRadius: 2 }} /> <Text type="secondary" style={{ fontSize: 11 }}>4-6盒</Text></Space>
                    <Space size={4}><div style={{ width: 12, height: 12, background: '#ffe0b2', borderRadius: 2 }} /> <Text type="secondary" style={{ fontSize: 11 }}>7-8盒</Text></Space>
                    <Space size={4}><div style={{ width: 12, height: 12, background: '#f8d7da', borderRadius: 2 }} /> <Text type="secondary" style={{ fontSize: 11 }}>9-10盒</Text></Space>
                  </div>
                </>
              )}
            </Card>
          </>
        )}
      </Spin>

      {/* 货位详情弹窗 */}
      <Modal
        title={
          <Space>
            <BoxPlotOutlined />
            <span>货位详情 - {selectedLocation?.code}</span>
          </Space>
        }
        open={detailOpen}
        onCancel={() => { setDetailOpen(false); setSelectedLocation(null); }}
        footer={null}
        width={isMobile ? '95%' : 600}
      >
        {selectedLocation && (
          <>
            <Descriptions column={isMobile ? 1 : 2} bordered size="small" style={{ marginBottom: 16 }}>
              <Descriptions.Item label="货位编码">{selectedLocation.code}</Descriptions.Item>
              <Descriptions.Item label="所属货架">{selectedLocation.zoneCode}货架</Descriptions.Item>
              <Descriptions.Item label="状态">
                {selectedLocation.usedBoxes > 0 ? <Tag color="green">有货</Tag> : <Tag color="default">空置</Tag>}
              </Descriptions.Item>
              <Descriptions.Item label="使用情况">
                <Progress 
                  percent={Math.round(selectedLocation.usedBoxes / 10 * 100)} 
                  size="small"
                  format={() => `${selectedLocation.usedBoxes}/10盒`}
                />
              </Descriptions.Item>
            </Descriptions>

            <Title level={5}>盒子明细 (共10个)</Title>
            <div style={{ 
              display: 'grid',
              gridTemplateColumns: isMobile ? 'repeat(2, 1fr)' : 'repeat(5, 1fr)',
              gap: 8,
              marginTop: 8
            }}>
              {selectedLocation.boxes.map((box, index) => (
                <Card
                  key={index}
                  size="small"
                  hoverable
                  style={{ 
                    background: box.occupied ? '#e6f4ff' : '#fafafa',
                    border: box.occupied ? '1px solid #91caff' : '1px solid #f0f0f0',
                  }}
                >
                  <div style={{ textAlign: 'center' }}>
                    <div style={{ fontWeight: 600, fontSize: 13, color: '#1f2937' }}>
                      盒子 {index + 1}
                    </div>
                    <div style={{ fontSize: 11, color: '#666', marginTop: 2 }}>
                      {box.boxCode}
                    </div>
                    {box.occupied ? (
                      <div style={{ marginTop: 6 }}>
                        <div style={{ fontSize: 11, color: '#1677ff', fontWeight: 500 }}>
                          {box.productName || '-'}
                        </div>
                        <div style={{ fontSize: 10, color: '#999' }}>
                          {box.productCode || ''}
                        </div>
                        <Tag color="blue" style={{ marginTop: 4, fontSize: 11 }}>
                          数量: {box.quantity || 0}
                        </Tag>
                      </div>
                    ) : (
                      <div style={{ marginTop: 6, color: '#ccc', fontSize: 11 }}>
                        空置
                      </div>
                    )}
                  </div>
                </Card>
              ))}
            </div>
          </>
        )}
      </Modal>
    </div>
  );
}
