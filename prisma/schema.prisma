model PurchaseRequest {
  id             BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  requestNo      String    @unique @map("request_no") @db.VarChar(50)
  name           String    @db.VarChar(200) // 备件名称
  model          String?   @db.VarChar(100) // 型号
  color          String?   @db.VarChar(50) // 颜色
  size           String?   @db.VarChar(50) // 尺寸
  quantity       Decimal   @db.Decimal(18, 3) // 数量
  status         String    @default("PENDING") @db.VarChar(20) // PENDING-待采购/PURCHASING-采购中/COMPLETED-已完成/CANCELLED-已取消
  autoInbound    Boolean   @default(false) @map("auto_inbound") // 购买完成后直接入库
  warehouseId    BigInt?   @map("warehouse_id") @db.UnsignedBigInt // 入库仓库
  locationId     BigInt?   @map("location_id") @db.UnsignedBigInt // 入库货位（如 A-1-1）
  boxId          BigInt?   @map("box_id") @db.UnsignedBigInt // 入库盒子（4位码，如 A-1-1-1）
  inboundOrderId BigInt?   @map("inbound_order_id") @db.UnsignedBigInt // 关联入库单
  applicant      String?   @db.VarChar(50) // 申请人
  applicantId    BigInt?   @map("applicant_id") @db.UnsignedBigInt
  remark         String?   @db.VarChar(500)
  completedAt    DateTime? @map("completed_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  warehouse    Warehouse?    @relation(fields: [warehouseId], references: [id])
  location     Location?     @relation(fields: [locationId], references: [id])
  box          Box?          @relation(fields: [boxId], references: [id])
  inboundOrder InboundOrder? @relation(fields: [inboundOrderId], references: [id])

  @@index([status])
  @@map("purchase_requests")
}

