model SalesOrder {
  id           BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  orderNo      String    @unique @map("order_no") @db.VarChar(50)
  customerId   BigInt    @map("customer_id") @db.UnsignedBigInt
  status       String    @db.VarChar(20) // DRAFT/APPROVED/SHIPPED/CLOSED/CANCELLED
  totalAmount  Decimal?  @map("total_amount") @db.Decimal(18, 4)
  totalQty     Decimal?  @map("total_qty") @db.Decimal(18, 3)
  shippedQty   Decimal?  @map("shipped_qty") @db.Decimal(18, 3)
  expectedDate DateTime? @map("expected_date")
  remark       String?   @db.VarChar(500)
  imageUrl      String?   @map("image_url") @db.VarChar(500)
  useLocation   String?   @map("use_location") @db.VarChar(100) // 使用地点
  department    String?   @db.VarChar(50)   // 使用部门
  shift         String?   @db.VarChar(20)   // 使用班次
  recipientName String?   @map("recipient_name") @db.VarChar(50)  // 领用人
  recipientQty  Decimal?  @map("recipient_qty") @db.Decimal(18, 3) // 领用数量
  deptManager   String?   @map("dept_manager") @db.VarChar(50)   // 部门负责人
  recipientTime DateTime? @map("recipient_time") // 领用时间
  operatorId   BigInt?   @map("operator_id") @db.UnsignedBigInt
  approvedAt   DateTime? @map("approved_at")
  shippedAt    DateTime? @map("shipped_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  customer    Customer    @relation(fields: [customerId], references: [id])
  salesItems  SalesItem[]

  @@map("sales_orders")
}

model SalesItem {
  id           BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  orderId      BigInt   @map("order_id") @db.UnsignedBigInt
  productId    BigInt   @map("product_id") @db.UnsignedBigInt
  skuVariantId BigInt?  @map("sku_variant_id") @db.UnsignedBigInt
  quantity     Decimal  @db.Decimal(18, 3)
  shippedQty   Decimal? @map("shipped_qty") @db.Decimal(18, 3)
  unitPrice    Decimal  @map("unit_price") @db.Decimal(18, 4)
  amount       Decimal? @db.Decimal(18, 4)
  remark       String?  @db.VarChar(500)
  imageUrl      String?   @map("image_url") @db.VarChar(500)
  useLocation   String?   @map("use_location") @db.VarChar(100) // 使用地点
  department    String?   @db.VarChar(50)   // 使用部门
  shift         String?   @db.VarChar(20)   // 使用班次
  recipientName String?   @map("recipient_name") @db.VarChar(50)  // 领用人
  recipientQty  Decimal?  @map("recipient_qty") @db.Decimal(18, 3) // 领用数量
  deptManager   String?   @map("dept_manager") @db.VarChar(50)   // 部门负责人
  recipientTime DateTime? @map("recipient_time") // 领用时间
  createdAt    DateTime @default(now()) @map("created_at")

  order   SalesOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product    @relation(fields: [productId], references: [id])

  @@map("sales_items")
}

// ==================== BOM ====================

model Bom {
  id          BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  name        String   @db.VarChar(200)
  code        String   @unique @db.VarChar(50)
  productId   BigInt   @map("product_id") @db.UnsignedBigInt // 成品
  version     String   @db.VarChar(20) @default("1.0")
  status      Int      @default(1)
  remark      String?  @db.VarChar(500)
  imageUrl      String?   @map("image_url") @db.VarChar(500)
  useLocation   String?   @map("use_location") @db.VarChar(100) // 使用地点
  department    String?   @db.VarChar(50)   // 使用部门
  shift         String?   @db.VarChar(20)   // 使用班次
  recipientName String?   @map("recipient_name") @db.VarChar(50)  // 领用人
  recipientQty  Decimal?  @map("recipient_qty") @db.Decimal(18, 3) // 领用数量
  deptManager   String?   @map("dept_manager") @db.VarChar(50)   // 部门负责人
  recipientTime DateTime? @map("recipient_time") // 领用时间
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  product  Product   @relation(fields: [productId], references: [id])
  bomItems BomItem[]

  @@map("boms")
}

model BomItem {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  bomId     BigInt   @map("bom_id") @db.UnsignedBigInt
  productId BigInt   @map("product_id") @db.UnsignedBigInt // 物料
  quantity  Decimal  @db.Decimal(18, 3) // 单位用量
  wastage   Decimal? @db.Decimal(5, 2) @default(0) // 损耗率%
  remark    String?  @db.VarChar(500)
  imageUrl      String?   @map("image_url") @db.VarChar(500)
  useLocation   String?   @map("use_location") @db.VarChar(100) // 使用地点
  department    String?   @db.VarChar(50)   // 使用部门
  shift         String?   @db.VarChar(20)   // 使用班次
  recipientName String?   @map("recipient_name") @db.VarChar(50)  // 领用人
  recipientQty  Decimal?  @map("recipient_qty") @db.Decimal(18, 3) // 领用数量
  deptManager   String?   @map("dept_manager") @db.VarChar(50)   // 部门负责人
  recipientTime DateTime? @map("recipient_time") // 领用时间
  createdAt DateTime @default(now()) @map("created_at")

  bom     Bom     @relation(fields: [bomId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@map("bom_items")
}

// ==================== 预警 ====================

model AlertRule {
  id          BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  name        String   @db.VarChar(100)
  type        String   @db.VarChar(30) // LOW_STOCK/OVERSTOCK/EXPIRY/REORDER
  targetType  String   @map("target_type") @db.VarChar(20) // PRODUCT/WAREHOUSE/ALL
  targetId    BigInt?  @map("target_id") @db.UnsignedBigInt
  condition   Json     // {"threshold": 10, "operator": "lt"}
  notifyType  String   @map("notify_type") @db.VarChar(20) // SYSTEM/EMAIL/SMS
  status      Int      @default(1)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  alerts Alert[]

  @@map("alert_rules")
}

model Alert {
  id          BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  ruleId      BigInt   @map("rule_id") @db.UnsignedBigInt
  productId   BigInt?  @map("product_id") @db.UnsignedBigInt
  warehouseId BigInt?  @map("warehouse_id") @db.UnsignedBigInt
  level       String   @db.VarChar(10) // INFO/WARNING/CRITICAL
  title       String   @db.VarChar(200)
  content     String?  @db.Text
  status      String   @db.VarChar(20) @default("UNREAD") // UNREAD/READ/RESOLVED
  readAt      DateTime? @map("read_at")
  resolvedAt  DateTime? @map("resolved_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  rule AlertRule @relation(fields: [ruleId], references: [id])

  @@map("alerts")
}

// ==================== 审批 ====================

model ApprovalFlow {
  id           BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  refType      String    @map("ref_type") @db.VarChar(30)
  refId        BigInt    @map("ref_id") @db.UnsignedBigInt
  refNo        String    @map("ref_no") @db.VarChar(50)
  status       String    @db.VarChar(20) // PENDING/APPROVED/REJECTED
  applicantId  BigInt    @map("applicant_id") @db.UnsignedBigInt
  approverId   BigInt?   @map("approver_id") @db.UnsignedBigInt
  remark       String?   @db.VarChar(500)
  imageUrl      String?   @map("image_url") @db.VarChar(500)
  useLocation   String?   @map("use_location") @db.VarChar(100) // 使用地点
  department    String?   @db.VarChar(50)   // 使用部门
  shift         String?   @db.VarChar(20)   // 使用班次
  recipientName String?   @map("recipient_name") @db.VarChar(50)  // 领用人
  recipientQty  Decimal?  @map("recipient_qty") @db.Decimal(18, 3) // 领用数量
  deptManager   String?   @map("dept_manager") @db.VarChar(50)   // 部门负责人
  recipientTime DateTime? @map("recipient_time") // 领用时间
  approvedAt   DateTime? @map("approved_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@index([refType, refId])
  @@map("approval_flows")
}

// ==================== 标签打印 ====================

model LabelTemplate {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  name      String   @db.VarChar(100)
  code      String   @unique @db.VarChar(50)
  type      String   @db.VarChar(20) // PRODUCT/LOCATION/LOT
  content   Json     // 模板JSON定义
  status    Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  printJobs LabelPrintJob[]

  @@map("label_templates")
}

model LabelPrintJob {
  id         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  templateId BigInt   @map("template_id") @db.UnsignedBigInt
  data       Json     // 打印数据
  copies     Int      @default(1)
  status     String   @db.VarChar(20) // PENDING/PRINTED/FAILED
  printer    String?  @db.VarChar(100)
  operatorId BigInt?  @map("operator_id") @db.UnsignedBigInt
  createdAt  DateTime @default(now()) @map("created_at")

  template LabelTemplate @relation(fields: [templateId], references: [id])

  @@map("label_print_jobs")
}

// ==================== 系统 ====================

model ExportTask {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  type       String    @db.VarChar(30) // PRODUCT/INVENTORY/INBOUND/OUTBOUND等
  status     String    @db.VarChar(20) // PENDING/PROCESSING/COMPLETED/FAILED
  params     Json?     // 导出参数
  fileUrl    String?   @map("file_url") @db.VarChar(500)
  fileName   String?   @map("file_name") @db.VarChar(200)
  errorMsg   String?   @map("error_msg") @db.Text
  userId     BigInt?   @map("user_id") @db.UnsignedBigInt
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  user User? @relation(fields: [userId], references: [id])

  @@map("export_tasks")
}

model ReportSnapshot {
  id         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  type       String   @db.VarChar(30) // STOCK_MOVEMENT/TURNOVER/AGING
  period     String   @db.VarChar(20) // 2024-01, 2024-Q1
  data       Json     // 快照数据
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([type, period])
  @@map("report_snapshots")
}

model CostSnapshot {
  id          BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  productId   BigInt   @map("product_id") @db.UnsignedBigInt
  warehouseId BigInt?  @map("warehouse_id") @db.UnsignedBigInt
  period      String   @db.VarChar(20) // 2024-01
  beginQty    Decimal? @map("begin_qty") @db.Decimal(18, 3)
  beginAmount Decimal? @map("begin_amount") @db.Decimal(18, 4)
  inQty       Decimal? @map("in_qty") @db.Decimal(18, 3)
  inAmount    Decimal? @map("in_amount") @db.Decimal(18, 4)
  outQty      Decimal? @map("out_qty") @db.Decimal(18, 3)
  outAmount   Decimal? @map("out_amount") @db.Decimal(18, 4)
  endQty      Decimal? @map("end_qty") @db.Decimal(18, 3)
  endAmount   Decimal? @map("end_amount") @db.Decimal(18, 4)
  avgCost     Decimal? @map("avg_cost") @db.Decimal(18, 4)
  createdAt   DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id])

  @@unique([productId, warehouseId, period])
  @@map("cost_snapshots")
}

model ProductCostSetting {
  id          BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  productId   BigInt   @unique @map("product_id") @db.UnsignedBigInt
  costMethod  String   @map("cost_method") @db.VarChar(20) // WEIGHTED/FIFO/MONTHLY
  remark      String?  @db.VarChar(500)
  imageUrl      String?   @map("image_url") @db.VarChar(500)
  useLocation   String?   @map("use_location") @db.VarChar(100) // 使用地点
  department    String?   @db.VarChar(50)   // 使用部门
  shift         String?   @db.VarChar(20)   // 使用班次
  recipientName String?   @map("recipient_name") @db.VarChar(50)  // 领用人
  recipientQty  Decimal?  @map("recipient_qty") @db.Decimal(18, 3) // 领用数量
  deptManager   String?   @map("dept_manager") @db.VarChar(50)   // 部门负责人
  recipientTime DateTime? @map("recipient_time") // 领用时间
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id])

  @@map("product_cost_settings")
}

model OperationLog {
  id         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  userId     BigInt?  @map("user_id") @db.UnsignedBigInt
  module     String   @db.VarChar(50)
  action     String   @db.VarChar(50)
  refType    String?  @map("ref_type") @db.VarChar(30)
  refId      BigInt?  @map("ref_id") @db.UnsignedBigInt
  content    String?  @db.Text
  ip         String?  @db.VarChar(50)
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([module, action])
  @@index([createdAt])
  @@map("operation_logs")
}

// ==================== 小程序登录会话 ====================

model MpSession {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  token     String   @unique @db.VarChar(64)
  userId    BigInt   @map("user_id") @db.UnsignedBigInt
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("mp_sessions")
}
