// 数据库连接配置
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ==================== 组织与权限 ====================

model Organization {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  name      String   @db.VarChar(100)
  code      String   @unique @db.VarChar(50)
  parentId  BigInt?  @map("parent_id") @db.UnsignedBigInt
  status    Int      @default(1) // 1-启用 0-禁用
  remark    String?  @db.VarChar(500)
  imageUrl      String?   @map("image_url") @db.VarChar(500)
  useLocation   String?   @map("use_location") @db.VarChar(100) // 使用地点
  department    String?   @db.VarChar(50)   // 使用部门
  shift         String?   @db.VarChar(20)   // 使用班次
  recipientName String?   @map("recipient_name") @db.VarChar(50)  // 领用人
  recipientQty  Decimal?  @map("recipient_qty") @db.Decimal(18, 3) // 领用数量
  deptManager   String?   @map("dept_manager") @db.VarChar(50)   // 部门负责人
  recipientTime DateTime? @map("recipient_time") // 领用时间
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  parent   Organization?  @relation("OrgTree", fields: [parentId], references: [id])
  children Organization[] @relation("OrgTree")
  users    User[]

  @@map("organizations")
}

model User {
  id             BigInt       @id @default(autoincrement()) @db.UnsignedBigInt
  username       String       @unique @db.VarChar(50)
  password       String       @db.VarChar(255)
  realName       String       @map("real_name") @db.VarChar(50)
  phone          String?      @db.VarChar(20)
  email          String?      @db.VarChar(100)
  orgId          BigInt?      @map("org_id") @db.UnsignedBigInt
  status         Int          @default(1) // 1-启用 0-禁用
  lastLoginAt    DateTime?    @map("last_login_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  organization   Organization? @relation(fields: [orgId], references: [id])
  userRoles      UserRole[]
  operationLogs  OperationLog[]
  exportTasks    ExportTask[]
  mpSessions     MpSession[]
  emailVerified      Boolean     @default(false) @map("email_verified")
  verifyToken        String?     @map("verify_token") @db.VarChar(64)
  verifyTokenExpires DateTime?  @map("verify_token_expires")
  securityQuestion  String?    @map("security_question") @db.VarChar(200)
  securityAnswer    String?    @map("security_answer") @db.VarChar(200)

  @@map("users")
}

model Role {
  id          BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  name        String   @db.VarChar(50)
  code        String   @unique @db.VarChar(50)
  remark      String?  @db.VarChar(500)
  status      Int      @default(1)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  rolePermissions RolePermission[]
  userRoles       UserRole[]
  }


// 系统配置表（用于 SMTP、OSS、系统参数等）
model SystemConfig {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  category  String   @map("category") @db.VarChar(50)
  colKey    String   @map("col_key") @db.VarChar(100)
  value     String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([category, colKey])
  @@map("system_configs")
}

model Permission {
  id          BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  name        String   @db.VarChar(50)
  code        String   @unique @db.VarChar(100)
  type        String   @db.VarChar(20) // menu/button/api
  parentId    BigInt?  @map("parent_id") @db.UnsignedBigInt
  path        String?  @db.VarChar(200)
  icon        String?  @db.VarChar(100)
  sort        Int      @default(0)
  status      Int      @default(1)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  parent          Permission?      @relation("PermTree", fields: [parentId], references: [id])
  children        Permission[]     @relation("PermTree")
  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  roleId       BigInt   @map("role_id") @db.UnsignedBigInt
  permissionId BigInt   @map("permission_id") @db.UnsignedBigInt
  createdAt    DateTime @default(now()) @map("created_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  userId    BigInt   @map("user_id") @db.UnsignedBigInt
  roleId    BigInt   @map("role_id") @db.UnsignedBigInt
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

// ==================== 基础数据 ====================

model Unit {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  name      String   @db.VarChar(20)
  code      String   @unique @db.VarChar(20)
  status    Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  products Product[]

  @@map("units")
}

model Category {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  name      String   @db.VarChar(100)
  code      String   @unique @db.VarChar(50)
  parentId  BigInt?  @map("parent_id") @db.UnsignedBigInt
  level     Int      @default(1)
  sort      Int      @default(0)
  status    Int      @default(1)
  remark    String?  @db.VarChar(500)
  imageUrl      String?   @map("image_url") @db.VarChar(500)
  useLocation   String?   @map("use_location") @db.VarChar(100) // 使用地点
  department    String?   @db.VarChar(50)   // 使用部门
  shift         String?   @db.VarChar(20)   // 使用班次
  recipientName String?   @map("recipient_name") @db.VarChar(50)  // 领用人
  recipientQty  Decimal?  @map("recipient_qty") @db.Decimal(18, 3) // 领用数量
  deptManager   String?   @map("dept_manager") @db.VarChar(50)   // 部门负责人
  recipientTime DateTime? @map("recipient_time") // 领用时间
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  parent   Category?  @relation("CatTree", fields: [parentId], references: [id])
  children Category[] @relation("CatTree")
  products Product[]

  @@map("categories")
}

model Supplier {
  id          BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  name        String   @db.VarChar(200)
  code        String   @unique @db.VarChar(50)
  contact     String?  @db.VarChar(50)
  phone       String?  @db.VarChar(20)
  email       String?  @db.VarChar(100)
  address     String?  @db.VarChar(500)
  bankAccount String?  @map("bank_account") @db.VarChar(100)
  bankName    String?  @map("bank_name") @db.VarChar(100)
  taxNo       String?  @map("tax_no") @db.VarChar(50)
  status      Int      @default(1)
  remark      String?  @db.VarChar(500)
  imageUrl      String?   @map("image_url") @db.VarChar(500)
  useLocation   String?   @map("use_location") @db.VarChar(100) // 使用地点
  department    String?   @db.VarChar(50)   // 使用部门
  shift         String?   @db.VarChar(20)   // 使用班次
  recipientName String?   @map("recipient_name") @db.VarChar(50)  // 领用人
  recipientQty  Decimal?  @map("recipient_qty") @db.Decimal(18, 3) // 领用数量
  deptManager   String?   @map("dept_manager") @db.VarChar(50)   // 部门负责人
  recipientTime DateTime? @map("recipient_time") // 领用时间
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  productSuppliers ProductSupplier[]
  purchaseOrders   PurchaseOrder[]
  inboundOrders    InboundOrder[]

  @@map("suppliers")
}

model Customer {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  name      String   @db.VarChar(200)
  code      String   @unique @db.VarChar(50)
  contact   String?  @db.VarChar(50)
  phone     String?  @db.VarChar(20)
  email     String?  @db.VarChar(100)
  address   String?  @db.VarChar(500)
  status    Int      @default(1)
  remark    String?  @db.VarChar(500)
  imageUrl      String?   @map("image_url") @db.VarChar(500)
  useLocation   String?   @map("use_location") @db.VarChar(100) // 使用地点
  department    String?   @db.VarChar(50)   // 使用部门
  shift         String?   @db.VarChar(20)   // 使用班次
  recipientName String?   @map("recipient_name") @db.VarChar(50)  // 领用人
  recipientQty  Decimal?  @map("recipient_qty") @db.Decimal(18, 3) // 领用数量
  deptManager   String?   @map("dept_manager") @db.VarChar(50)   // 部门负责人
  recipientTime DateTime? @map("recipient_time") // 领用时间
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  salesOrders SalesOrder[]
  outboundOrders OutboundOrder[]

  @@map("customers")
}

// ==================== 商品 ====================

model Product {
  id             BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  name           String   @db.VarChar(200)
  code           String   @unique @db.VarChar(50)
  barcode        String?  @unique @db.VarChar(50)
  categoryId     BigInt?  @map("category_id") @db.UnsignedBigInt
  unitId         BigInt?  @map("unit_id") @db.UnsignedBigInt
  spec           String?  @db.VarChar(500) // 规格说明
  specJson       Json?    @map("spec_json") // 结构化规格JSON
  brand          String?  @db.VarChar(100)
  model          String?  @db.VarChar(100)
  weight         Decimal? @db.Decimal(10, 3)
  volume         Decimal? @db.Decimal(10, 4)
  safetyStock    Decimal? @map("safety_stock") @db.Decimal(18, 3)
  maxStock       Decimal? @map("max_stock") @db.Decimal(18, 3)
  leadTimeDays   Int?     @map("lead_time_days")
  shelfLifeDays  Int?     @map("shelf_life_days")
  defaultCost    Decimal? @map("default_cost") @db.Decimal(18, 4)
  salePrice      Decimal? @map("sale_price") @db.Decimal(18, 4)
  costMethod     String   @map("cost_method") @db.VarChar(20) // WEIGHTED/FIFO/MONTHLY
  enableSerial   Boolean  @map("enable_serial") @default(false)
  enableBatch    Boolean  @map("enable_batch") @default(false)
  status         Int      @default(1) // 1-启用 0-禁用
  remark         String?  @db.VarChar(500)
  imageUrl      String?   @map("image_url") @db.VarChar(500)
  useLocation   String?   @map("use_location") @db.VarChar(100) // 使用地点
  department    String?   @db.VarChar(50)   // 使用部门
  shift         String?   @db.VarChar(20)   // 使用班次
  recipientName String?   @map("recipient_name") @db.VarChar(50)  // 领用人
  recipientQty  Decimal?  @map("recipient_qty") @db.Decimal(18, 3) // 领用数量
  deptManager   String?   @map("dept_manager") @db.VarChar(50)   // 部门负责人
  recipientTime DateTime? @map("recipient_time") // 领用时间
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  category         Category?          @relation(fields: [categoryId], references: [id])
  unit             Unit?              @relation(fields: [unitId], references: [id])
  productSuppliers ProductSupplier[]
  skuVariants      SkuVariant[]
  inventories      Inventory[]
  inventoryLots    InventoryLot[]
  locationStocks   LocationStock[]
  serialNumbers    SerialNumber[]
  inboundItems     InboundItem[]
  outboundItems    OutboundItem[]
  countItems       CountItem[]
  purchaseItems    PurchaseItem[]
  salesItems       SalesItem[]
  bomItems         BomItem[]
  transferItems    TransferItem[]
  boms             Bom[]
  costSettings     ProductCostSetting[]
  costSnapshots    CostSnapshot[]

  @@map("products")
}

model ProductSupplier {
  id         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  productId  BigInt   @map("product_id") @db.UnsignedBigInt
  supplierId BigInt   @map("supplier_id") @db.UnsignedBigInt
  isDefault  Boolean  @map("is_default") @default(false)
  purchasePrice Decimal? @map("purchase_price") @db.Decimal(18, 4)
  leadDays   Int?     @map("lead_days")
  remark     String?  @db.VarChar(500)
  imageUrl      String?   @map("image_url") @db.VarChar(500)
  useLocation   String?   @map("use_location") @db.VarChar(100) // 使用地点
  department    String?   @db.VarChar(50)   // 使用部门
  shift         String?   @db.VarChar(20)   // 使用班次
  recipientName String?   @map("recipient_name") @db.VarChar(50)  // 领用人
  recipientQty  Decimal?  @map("recipient_qty") @db.Decimal(18, 3) // 领用数量
  deptManager   String?   @map("dept_manager") @db.VarChar(50)   // 部门负责人
  recipientTime DateTime? @map("recipient_time") // 领用时间
  createdAt  DateTime @default(now()) @map("created_at")

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([productId, supplierId])
  @@map("product_suppliers")
}

model SkuVariant {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  productId BigInt   @map("product_id") @db.UnsignedBigInt
  sku       String   @unique @db.VarChar(100)
  attrJson  Json     @map("attr_json") // {"颜色":"红","尺寸":"XL"}
  barcode   String?  @db.VarChar(50)
  price     Decimal? @db.Decimal(18, 4)
  status    Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("sku_variants")
}

// ==================== 仓库 ====================

model Warehouse {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  name      String   @db.VarChar(100)
  code      String   @unique @db.VarChar(50)
  address   String?  @db.VarChar(500)
  contact   String?  @db.VarChar(50)
  phone     String?  @db.VarChar(20)
  status    Int      @default(1)
  remark    String?  @db.VarChar(500)
  imageUrl      String?   @map("image_url") @db.VarChar(500)
  useLocation   String?   @map("use_location") @db.VarChar(100) // 使用地点
  department    String?   @db.VarChar(50)   // 使用部门
  shift         String?   @db.VarChar(20)   // 使用班次
  recipientName String?   @map("recipient_name") @db.VarChar(50)  // 领用人
  recipientQty  Decimal?  @map("recipient_qty") @db.Decimal(18, 3) // 领用数量
  deptManager   String?   @map("dept_manager") @db.VarChar(50)   // 部门负责人
  recipientTime DateTime? @map("recipient_time") // 领用时间
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  zones         Zone[]
  inventories   Inventory[]
  inventoryLots InventoryLot[]
  locationStocks LocationStock[]
  outboundOrders OutboundOrder[]
  inboundOrders  InboundOrder[]
  countOrders    CountOrder[]
  purchaseRequests PurchaseRequest[]

  @@map("warehouses")
}

model Zone {
  id          BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  name        String   @db.VarChar(100)
  code        String   @db.VarChar(50)
  warehouseId BigInt   @map("warehouse_id") @db.UnsignedBigInt
  type        String?  @db.VarChar(20) // storage/staging/quarantine
  status      Int      @default(1)
  remark      String?  @db.VarChar(500)
  imageUrl      String?   @map("image_url") @db.VarChar(500)
  useLocation   String?   @map("use_location") @db.VarChar(100) // 使用地点
  department    String?   @db.VarChar(50)   // 使用部门
  shift         String?   @db.VarChar(20)   // 使用班次
  recipientName String?   @map("recipient_name") @db.VarChar(50)  // 领用人
  recipientQty  Decimal?  @map("recipient_qty") @db.Decimal(18, 3) // 领用数量
  deptManager   String?   @map("dept_manager") @db.VarChar(50)   // 部门负责人
  recipientTime DateTime? @map("recipient_time") // 领用时间
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  locations Location[]

  @@unique([warehouseId, code])
  @@map("zones")
}

model Location {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  name      String   @db.VarChar(100)
  code      String   @db.VarChar(50)
  zoneId    BigInt   @map("zone_id") @db.UnsignedBigInt
  type      String?  @db.VarChar(20) // shelf/floor/rack
  capacity  Decimal? @db.Decimal(18, 3)
  status    Int      @default(1)
  remark    String?  @db.VarChar(500)
  imageUrl      String?   @map("image_url") @db.VarChar(500)
  useLocation   String?   @map("use_location") @db.VarChar(100) // 使用地点
  department    String?   @db.VarChar(50)   // 使用部门
  shift         String?   @db.VarChar(20)   // 使用班次
  recipientName String?   @map("recipient_name") @db.VarChar(50)  // 领用人
  recipientQty  Decimal?  @map("recipient_qty") @db.Decimal(18, 3) // 领用数量
  deptManager   String?   @map("dept_manager") @db.VarChar(50)   // 部门负责人
  recipientTime DateTime? @map("recipient_time") // 领用时间
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  zone Zone @relation(fields: [zoneId], references: [id])
  locationStocks LocationStock[]
  boxes          Box[]
  inboundItems   InboundItem[]
  purchaseRequests PurchaseRequest[]

  @@unique([zoneId, code])
  @@map("locations")
}

// ==================== 库存核心 ====================

model Inventory {
  id          BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  productId   BigInt    @map("product_id") @db.UnsignedBigInt
  warehouseId BigInt    @map("warehouse_id") @db.UnsignedBigInt
  locationId  BigInt?   @map("location_id") @db.UnsignedBigInt
  skuVariantId BigInt?  @map("sku_variant_id") @db.UnsignedBigInt
  onHand      Decimal   @map("on_hand") @default(0) @db.Decimal(18, 3) // 在手量
  locked      Decimal   @default(0) @db.Decimal(18, 3) // 锁定量
  // available 是生成列：on_hand - locked
  available   Decimal   @default(0) @db.Decimal(18, 3) // @map("available")
  avgCost     Decimal?  @map("avg_cost") @db.Decimal(18, 4) // 移动加权平均成本
  version     Int       @default(0) // 乐观锁版本号
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  product    Product     @relation(fields: [productId], references: [id])
  warehouse  Warehouse   @relation(fields: [warehouseId], references: [id])
  locationStocks LocationStock[]

  @@unique([productId, warehouseId, skuVariantId])
  @@map("inventory")
}


model Box {
  id         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  locationId BigInt   @map("location_id") @db.UnsignedBigInt
  code       String   @db.VarChar(50)
  status     Int      @default(1) // 1-启用 0-封存
  remark     String?  @db.VarChar(500)
  imageUrl      String?   @map("image_url") @db.VarChar(500)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  location       Location        @relation(fields: [locationId], references: [id], onDelete: Cascade)
  locationStocks LocationStock[]
  purchaseRequests PurchaseRequest[]

  @@unique([locationId, code])
  @@index([locationId])
  @@map("boxes")
}

model LocationStock {
  id          BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  inventoryId BigInt   @map("inventory_id") @db.UnsignedBigInt
  productId   BigInt   @map("product_id") @db.UnsignedBigInt
  warehouseId BigInt   @map("warehouse_id") @db.UnsignedBigInt
  locationId  BigInt   @map("location_id") @db.UnsignedBigInt
  boxId      BigInt?  @map("box_id") @db.UnsignedBigInt
  lotNumber   String?  @map("lot_number") @db.VarChar(50)
  quantity    Decimal  @db.Decimal(18, 3)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  inventory Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  location  Location  @relation(fields: [locationId], references: [id])
  box       Box?      @relation(fields: [boxId], references: [id])

  @@index([inventoryId])
  @@index([locationId])
  @@map("location_stocks")
}

model InventoryLot {
  id           BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  productId    BigInt   @map("product_id") @db.UnsignedBigInt
  warehouseId  BigInt   @map("warehouse_id") @db.UnsignedBigInt
  lotNumber    String   @map("lot_number") @db.VarChar(50)
  skuVariantId BigInt?  @map("sku_variant_id") @db.UnsignedBigInt
  quantity     Decimal  @db.Decimal(18, 3)
  costPrice    Decimal? @map("cost_price") @db.Decimal(18, 4)
  producedAt   DateTime? @map("produced_at")
  expiredAt    DateTime? @map("expired_at")
  status       Int      @default(1) // 1-可用 2-冻结 3-过期
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  product   Product   @relation(fields: [productId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  @@map("inventory_lots")
}

model InventoryTransaction {
  id           BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  txnType      String   @map("txn_type") @db.VarChar(30) // INBOUND/OUTBOUND/TRANSFER/ADJUST/LOCK/UNLOCK
  refType      String   @map("ref_type") @db.VarChar(30) // 单据类型
  refId        BigInt   @map("ref_id") @db.UnsignedBigInt
  refNo        String   @map("ref_no") @db.VarChar(50)
  productId    BigInt   @map("product_id") @db.UnsignedBigInt
  warehouseId  BigInt   @map("warehouse_id") @db.UnsignedBigInt
  skuVariantId BigInt?  @map("sku_variant_id") @db.UnsignedBigInt
  lotNumber    String?  @map("lot_number") @db.VarChar(50)
